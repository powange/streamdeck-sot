{
    "name": "streamdeck-sot",
    "version": "0.1.0",
    "private": true,
    "description": "Stream Deck plugin for Sea of Thieves: cooking timers and session counters.",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.powange.seaofthieves\"",
        "typecheck": "tsc --noEmit",
        "validate": "streamdeck validate com.powange.seaofthieves.sdPlugin",
        "pack": "npm run build && streamdeck pack com.powange.seaofthieves.sdPlugin --force",
        "deploy:win": "npm run build && bash scripts/deploy-windows.sh"
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.10.2",
        "@elgato/utils": "^0.6.1",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^24.12.0",
        "rollup": "^4.64.5",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@elgato/streamdeck": "^3.0.2"
    }
}
